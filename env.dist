# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: mysql://root:password@localhost:3306/nextbroadcastmedia
# For cloud providers, use the connection string provided by your hosting service
DATABASE_URL=

# SMTP Email Configuration
# SMTP Host (e.g., smtp.gmail.com, smtp.outlook.com, smtp.mailtrap.io)
SMTP_HOST="smtp.sendgrid.net"
# SMTP Port (587 for TLS, 465 for SSL, 25 for non-encrypted)
SMTP_PORT=
# SMTP Secure (true for SSL/465, false for TLS/587)
SMTP_SECURE="false"
# SMTP Username (your email address)
SMTP_USER=
# SMTP Password (your email password or app-specific password)
SMTP_PASS=

# Email Configuration
# Email address to receive brief submissions
ADMIN_EMAIL=
# Email address to send emails from (should match SMTP_USER or be verified)
FROM_EMAIL=

# Base URL (for file links in emails)
BASE_URL="http://localhost:3000"

# HubSpot (Campaign enquiry popup)
# Use a HubSpot Form to capture these submissions.
# Required:
HUBSPOT_PORTAL_ID=
HUBSPOT_CAMPAIGN_ENQUIRY_FORM_GUID=
